{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git rev-list *)",
      "Bash(git ls-files *)",
      "Bash(git branch *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(date *)",
      "Bash(python3 .claude/scripts/teacher_context.py)",
      "Bash(python3 .claude/scripts/teacher_context.py *)",
      "Skill(daily-task)",
      "Skill(daily-review)",
      "Skill(week)",
      "Skill(test-noai)",
      "Skill(weakness)",
      "Agent(reviewer)"
    ]
  },
  "enabledPlugins": {
    "claude-security@claude-plugins-official": false
  },
  "skillOverrides": {
    "swift-daily-review": "off",
    "animation-vocabulary": "off",
    "apple-design": "off",
    "beginner-purpose-code": "off",
    "dev-plan": "off",
    "emil-design-eng": "off",
    "frontend-design": "off",
    "goa-service-designer": "off",
    "improve": "off",
    "improve-animations": "off",
    "japanese-natural-writing": "off",
    "last30days": "off",
    "monad-html": "off",
    "note-product-qa": "off",
    "stop-ai-slop-jp": "off",
    "typst-slide-rebuilder": "off",
    "ui-ux-pro-max": "off",
    "vercel-react-best-practices": "off"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_learning_code.py\""
          }
        ]
      }
    ]
  }
}
